DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=development-only-change-before-deploying
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Runtime connection: app_user (RLS enforced). Migrations override this in compose.
APP_DATABASE_URL=postgresql://app_user:app_user@db:5432/compliance
DATABASE_URL=postgres://app_user:app_user@db:5432/compliance

REDIS_URL=redis://redis:6379/0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Webhook signing secret (dev only)
WEBHOOK_SIGNING_SECRET=dev-webhook-secret

# Per-tenant distributed API rate limit (DRF throttle format)
API_TENANT_RATE=1000/min

# Enable only after deploying readers that can evaluate pinned rule references.
RULE_REFERENCES_ENABLED=false
